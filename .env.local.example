# ====================================================
# GAT PRIME — העתיקו קובץ זה אל .env.local
# ====================================================

# --- PAYPAL ---
# קבלו מ: developer.paypal.com → Apps & Credentials
# ⚠️  Client ID בטוח לחשוף (NEXT_PUBLIC)
# ⚠️  Secret — סודי! אל תשתפו אף פעם!

NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id-here
PAYPAL_CLIENT_SECRET=your-paypal-secret-here
PAYPAL_MODE=sandbox   # sandbox לבדיקות | live לייצור

# --- SITE ---
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
